<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitDefaultTargetFramework)</TargetFramework>
    <AssemblyName>WebUIToolkit.MVVM.Flow</AssemblyName>
    <RootNamespace>WebUIToolkit.MVVM.Flow</RootNamespace>
    <PackageId>WebUIToolkit.MVVM.Flow</PackageId>
    <Title>WebUIToolkit MVVM Flow</Title>
    <Description>Frontend-neutral navigation, dialogs, operations, and workflow contracts for WebUIToolkit MVVM applications.</Description>
    <Authors>WebUIToolkit contributors</Authors>
    <PackageTags>webuitoolkit;mvvm;navigation;dialogs;workflow</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
    <!-- The frozen contract intentionally follows the standard result-type factory shape. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebUIToolkit.Desktop\WebUIToolkit.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
