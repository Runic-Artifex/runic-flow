<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicFlowDefaultTargetFramework)</TargetFramework>
    <AssemblyName>RunicFlow</AssemblyName>
    <RootNamespace>RunicFlow</RootNamespace>
    <PackageId>RunicFlow</PackageId>
    <Title>Runic Flow</Title>
    <Description>Headless process orchestration and coordinated operation primitives for .NET applications.</Description>
    <Authors>RunicArtifex</Authors>
    <PackageTags>runic;flow;process;operations;orchestration;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <RunicFlowShippingProject>true</RunicFlowShippingProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Generic decision/outcome factories keep nullable result semantics explicit. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Core/**/*.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
