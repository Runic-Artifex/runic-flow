<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicFlowDefaultTargetFramework)</TargetFramework>
    <AssemblyName>RunicFlow.CommunityToolkit</AssemblyName>
    <RootNamespace>RunicFlow.CommunityToolkit</RootNamespace>
    <PackageId>RunicFlow.CommunityToolkit</PackageId>
    <Title>Runic Flow CommunityToolkit integration</Title>
    <Description>Reflection-free CommunityToolkit.Mvvm generated-member projections for Runic Flow.</Description>
    <Authors>RunicArtifex</Authors>
    <PackageTags>runic;flow;communitytoolkit;projection</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <RunicFlowShippingProject>true</RunicFlowShippingProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunicFlow\RunicFlow.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm"
                      Version="[8.4.2]"
                      PrivateAssets="contentfiles" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
