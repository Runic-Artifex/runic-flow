<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitGeneratorTargetFramework)</TargetFramework>
    <AssemblyName>WebUIToolkit.MVVM.Flow.Generators</AssemblyName>
    <RootNamespace>WebUIToolkit.MVVM.Flow.Generators</RootNamespace>
    <PackageId>WebUIToolkit.MVVM.Flow.Generators</PackageId>
    <Title>WebUIToolkit MVVM Flow Generator Contracts</Title>
    <Description>Roslyn-independent contracts and deterministic emission vocabulary for WebUIToolkit MVVM Flow generators.</Description>
    <Authors>WebUIToolkit contributors</Authors>
    <PackageTags>webuitoolkit;mvvm;flow;generator;diagnostics</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
