<Project>
  <PropertyGroup>
    <!--
      Development is the approachable inner loop. Verification is selected by CI
      and eng/verify.sh for release-grade analysis.
    -->
    <RunicFlowBuildMode Condition="'$(RunicFlowBuildMode)' == '' and '$(CI)' == 'true'">Verification</RunicFlowBuildMode>
    <RunicFlowBuildMode Condition="'$(RunicFlowBuildMode)' == ''">Development</RunicFlowBuildMode>
    <RunicFlowVerificationBuild Condition="'$(RunicFlowBuildMode)' == 'Verification'">true</RunicFlowVerificationBuild>
    <RunicFlowVerificationBuild Condition="'$(RunicFlowVerificationBuild)' == ''">false</RunicFlowVerificationBuild>

    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(RunicFlowVerificationBuild)' == 'true'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryType>git</RepositoryType>
    <Authors>RunicArtifex</Authors>
    <Company>RunicArtifex</Company>
    <Copyright>Copyright (c) 2026 Viktor Jannicke</Copyright>
    <RepositoryUrl>https://github.com/Runic-Artifex/runic-flow</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Runic-Artifex/runic-flow</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Libraries leave dependency resolution to their consuming applications. -->
    <NuGetAudit Condition="'$(RunicFlowVerificationBuild)' == 'true'">true</NuGetAudit>
    <NuGetAudit Condition="'$(NuGetAudit)' == ''">false</NuGetAudit>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RunicFlowDefaultTargetFramework>net10.0</RunicFlowDefaultTargetFramework>
    <RunicFlowGeneratorTargetFramework>net10.0</RunicFlowGeneratorTargetFramework>
  </PropertyGroup>
</Project>
