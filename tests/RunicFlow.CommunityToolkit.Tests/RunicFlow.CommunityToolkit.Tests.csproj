<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(RunicFlowDefaultTargetFramework)</TargetFramework>
    <AssemblyName>RunicFlow.CommunityToolkit.Tests</AssemblyName>
    <RootNamespace>RunicFlow.CommunityToolkit.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RunicFlow.CommunityToolkit/RunicFlow.CommunityToolkit.csproj" />
    <ProjectReference Include="../../src/RunicFlow.Generators/RunicFlow.Generators.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <!-- Toolkit MVVM wire-protocol evidence belongs to RunicFlow.RunicToolkit. -->
    <Compile Remove="G3EvidenceTests.cs" />
    <None Include="G3EvidenceTests.cs" />
  </ItemGroup>
</Project>
