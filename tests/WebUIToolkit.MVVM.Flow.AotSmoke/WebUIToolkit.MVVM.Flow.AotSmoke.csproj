<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WebUIToolkit.MVVM.Flow.AotSmoke</AssemblyName>
    <RootNamespace>WebUIToolkit.MVVM.Flow.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Condition="'$(FlowPackageVersion)' == ''"
      Include="../../src/WebUIToolkit.MVVM.Flow/WebUIToolkit.MVVM.Flow.csproj" />
    <PackageReference
      Condition="'$(FlowPackageVersion)' != ''"
      Include="WebUIToolkit.MVVM.Flow"
      Version="$(FlowPackageVersion)" />
  </ItemGroup>
</Project>
