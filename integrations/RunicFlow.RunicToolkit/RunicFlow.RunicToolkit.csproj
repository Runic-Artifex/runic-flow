<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicFlowDefaultTargetFramework)</TargetFramework>
    <AssemblyName>RunicFlow.RunicToolkit</AssemblyName>
    <RootNamespace>RunicFlow.RunicToolkit</RootNamespace>
    <PackageId>RunicFlow.RunicToolkit</PackageId>
    <Title>Runic Flow integration for Runic Toolkit</Title>
    <Description>Runic Toolkit desktop-lifetime integration owned and released by Runic Flow.</Description>
    <PackageTags>runic;flow;toolkit;desktop;navigation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <RunicFlowShippingProject>true</RunicFlowShippingProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RunicFlow/RunicFlow.csproj" />
    <PackageReference Include="RunicToolkit.Desktop" Version="[0.1.0-preview.4.1]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
