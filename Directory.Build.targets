<Project>
  <PropertyGroup Condition="'$(RunicFlowShippingProject)' == 'true'">
    <EnableTrimAnalyzer Condition="'$(EnableTrimAnalyzer)' == '' and ('$(RunicFlowVerificationBuild)' == 'true' or '$(PublishTrimmed)' == 'true' or '$(PublishAot)' == 'true')">true</EnableTrimAnalyzer>
    <EnableTrimAnalyzer Condition="'$(EnableTrimAnalyzer)' == ''">false</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="'$(EnableAotAnalyzer)' == '' and ('$(RunicFlowVerificationBuild)' == 'true' or '$(PublishAot)' == 'true')">true</EnableAotAnalyzer>
    <EnableAotAnalyzer Condition="'$(EnableAotAnalyzer)' == ''">false</EnableAotAnalyzer>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <Target Name="ValidateRunicFlowBuildMode" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(RunicFlowBuildMode)' != 'Development' and '$(RunicFlowBuildMode)' != 'Verification'"
      Text="RunicFlowBuildMode must be either Development or Verification." />
  </Target>
</Project>
